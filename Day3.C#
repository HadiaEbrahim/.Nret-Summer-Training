        //Write a program in C# Sharp to find the sum of all elements of the array.
        public static int Sum(int[] arr)
        {
            int sum = 0;
            for (int i = 0; i < arr.Length; i++) { 
                sum+= arr[i];
            }
            return sum;
        }
