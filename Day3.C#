        //4-Create a function named "IsPrime", which receives an integer number and returns true if it is prime, or false if it is not:
        public static bool isPrime(int n)
        {
            bool found = true;
            for(int i = 2; i * i <= n; i++)
            {
                if (n % i == 0)
                {
                    found = false;
                    break;
                } 
            }
            return found;
        }

        //5-Create an iterative (non-recursive) function to calculate the factorial of the number specified as parameter
        public static int fact(int n)
        {
            int fact = 1;
            for(int i = 1; i <= n; i++)
            {
                fact *= i;
            }
            return fact;
        }
